{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["docker", "git"],
    "allowUnsandboxedCommands": true,
    "enableWeakerNestedSandbox": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "*.npmjs.org",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false
    }
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "mcp__*"
    ],
    "deny": [
      "Bash(*~/.aws*)",
      "Bash(*~/.ssh*)",
      "Bash(*~/.gnupg*)",
      "Bash(*~/.config/gcloud*)",
      "Bash(*~/.databrickscfg*)",
      "Bash(*~/.netrc*)",
      "Bash(*~/.kube*)",
      "Bash(*~/.docker/config.json*)",
      "Bash(*~/.npmrc*)",
      "Bash(*~/.pypirc*)",
      "Bash(*~/.gem/credentials*)",
      "Bash(*~/.cargo/credentials*)",
      "Bash(*~/.azure*)",
      "Bash(*~/.config/gh*)",
      "Bash(*~/.config/hub*)",
      "Bash(*$HOME/.aws*)",
      "Bash(*$HOME/.ssh*)",
      "Bash(*$HOME/.gnupg*)",
      "Bash(*$HOME/.config/gcloud*)",
      "Bash(*$HOME/.databrickscfg*)",
      "Bash(*$HOME/.netrc*)",
      "Bash(*$HOME/.kube*)",
      "Bash(*$HOME/.docker/config.json*)",
      "Bash(*$HOME/.npmrc*)",
      "Bash(*$HOME/.pypirc*)",
      "Bash(*$HOME/.gem/credentials*)",
      "Bash(*$HOME/.cargo/credentials*)",
      "Bash(*$HOME/.azure*)",
      "Bash(*$HOME/.config/gh*)",
      "Bash(*$HOME/.config/hub*)",
      "Bash(* --profile prod*)",
      "Bash(* --profile=prod*)",
      "Bash(*PROD*)",
      "Bash(*prod.*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",

      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git push origin dev)",
      "Bash(git push origin dev *)",
      "Bash(git push origin develop)",
      "Bash(git push origin develop *)",
      "Bash(git push * +main)",
      "Bash(git push * +master)",
      "Bash(git push * +dev)",
      "Bash(git push * +develop)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push *:dev)",
      "Bash(git push *:dev *)",
      "Bash(git push *:develop)",
      "Bash(git push *:develop *)",
      "Bash(git push * :main)",
      "Bash(git push * :master)",
      "Bash(git push * :dev)",
      "Bash(git push * :develop)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*credential*)",
      "Read(**/.git-credentials)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*secret*key*)",
      "Read(**/*token*.json)",
      "Write(**/.env*)",
      "Write(**/secrets/**)",
      "Write(**/*.pem)",
      "Write(**/*credential*)",
      "Write(**/.git-credentials)",
      "Write(**/id_rsa*)",
      "Write(**/id_ed25519*)",
      "Write(**/*secret*key*)",
      "Write(**/*token*.json)"
    ]
  },
  "spinnerTipsOverride": {
    "excludeDefault": false,
    "tips": [
      "Use /pds:swarm to launch a parallel agent team",
      "Use /pds:grill to validate requirements before building",
      "Use /pds:verify before marking tasks complete",
      "Use /pds:bugfix for test-first bug fixing",
      "Use /pds:team to see available agents and roles"
    ]
  },
  "worktree": {
    "symlinkDirectories": ["node_modules", ".cache", ".bin", ".venv", "__pycache__"]
  },
  "autoMode": {
    "allow": [
      "Creating git worktrees",
      "Running tests and linters",
      "Reading and searching files",
      "Creating and switching branches",
      "Installing dependencies",
      "Spawning subagents via Task tool for parallel work",
      "Creating and managing agent teams (TeamCreate, TeamDelete)",
      "Creating and updating tasks (TaskCreate, TaskUpdate)",
      "Sending inter-agent messages (SendMessage)",
      "Worktree operations (create, remove, list)"
    ],
    "environment": [
      "PDS (Portable Dev System) plugin is active with skills and agents",
      "Worktree-based workflow: branches are isolated in .worktrees/",
      "Security-hardened: sandbox enabled, credential paths denied, protected branches blocked",
      "Agent teams: orchestrator coordinates workers, each in an isolated worktree",
      "Permission modes: plan (read-only agents), acceptEdits (implementation agents), default (orchestrator)",
      "Static deny rules block: credential paths, protected branches, sensitive files, production patterns",
      "OS-level sandbox confines Bash writes to working directory, network to domain allowlist",
      "Phase state machine tracks SDLC progression: plan → decompose → dispatch → validate → consolidate → knowledge",
      "Swarm tiers (lite/med/heavy) control model selection and specialist inclusion per agent role",
      "Branch naming: feature branches pushed to origin, PRs created after validation + review phases",
      "Source control: github.com (update with your GitHub org)",
      "Package registry: npmjs.org, pypi.org (update if using private registries)",
      "CI/CD system: (update with your CI — e.g., GitHub Actions, CircleCI, GitLab CI)",
      "Test infrastructure: (update if validators need test DB or service access)",
      "Internal APIs and services: (update with your trusted internal domains)"
    ]
  },
  "showClearContextOnPlanAccept": true,
  "plansDirectory": ".claude/plans",
  "showThinkingSummaries": true,
  "defaultView": "chat",
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/status-line.sh"
  },
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "fastModePerSessionOptIn": true,
  "attribution": {
    "pr": "\n\nGenerated with [PDS](https://github.com/rmzi/portable-dev-system)"
  }
}
